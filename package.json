{
  "name": "stackprism",
  "private": true,
  "version": "1.3.90",
  "license": "MIT",
  "type": "module",
  "description": "StackPrism 用于检测网页前端、后端、CDN、SaaS、广告营销、统计、登录、支付、网站程序和主题模板线索。",
  "scripts": {
    "typecheck": "vue-tsc --noEmit && bun run build",
    "lint": "eslint src",
    "build:injected": "node build-scripts/build-injected.mjs",
    "build": "bun run build:injected && vite build",
    "build:firefox": "bun run build && node build-scripts/package-firefox.mjs",
    "test:unit": "node --test tests/*.test.mjs",
    "check:links": "node build-scripts/check-tech-links.mjs",
    "extract:icons": "node build-scripts/extract-wappalyzer-icons.mjs",
    "dev": "bun run build:injected && vite",
    "docs:assets": "node build-scripts/sync-docs-assets.mjs",
    "docs:dev": "bun run docs:assets && vitepress dev docs",
    "docs:build": "bun run docs:assets && vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3",
    "@types/chrome": "^0.0.300",
    "@types/node": "^22",
    "@vitejs/plugin-vue": "^6",
    "@vue/eslint-config-typescript": "^14.9.0",
    "archiver": "^8",
    "esbuild": "^0.25",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "lucide-vue-next": "^1.0.0",
    "prettier": "^3.9.10",
    "sass-embedded": "^1.105.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8",
    "vite-tsconfig-paths": "^5",
    "vitepress": "^1.6.4",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  },
  "dependencies": {
    "vue-i18n": "^11.4.14"
  }
}
