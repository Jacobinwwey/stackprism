{
  "page": {
    "uiFrameworks": [
      {
        "defaults": {
          "category": "UI / CSS 框架"
        },
        "rules": [
          {
            "defaults": {
              "confidence": "高"
            },
            "rules": [
              {
                "name": "Bootstrap",
                "patterns": ["bootstrap(?:\\.bundle)?(?:\\.min)?\\.(?:js|css)"],
                "globals": ["bootstrap"]
              },
              {
                "name": "Tailwind CSS",
                "patterns": [
                  "cdn\\.tailwindcss\\.com",
                  "(?:^|/)[^\\s\"'<>/]*tailwind[^\\s\"'<>/]*\\.css(?:[?#]|[\"'<>\\s]|$)",
                  "tailwind\\.config"
                ]
              },
              {
                "name": "shadcn/ui",
                "patterns": ["@shadcn\\/ui", "class-variance-authority"],
                "cssVariables": [
                  "--background",
                  "--foreground",
                  "--card",
                  "--card-foreground",
                  "--popover",
                  "--popover-foreground",
                  "--primary",
                  "--primary-foreground",
                  "--secondary",
                  "--secondary-foreground",
                  "--muted",
                  "--muted-foreground",
                  "--accent",
                  "--accent-foreground",
                  "--destructive",
                  "--destructive-foreground",
                  "--border",
                  "--input",
                  "--ring",
                  "--radius"
                ],
                "minCssVariableMatches": 10
              }
            ]
          },
          {
            "name": "Sax Design Vue",
            "url": "https://github.com/adoin/sax-design-vue",
            "confidence": "中",
            "patterns": ["sax-design-vue", "(?:^|/)sax-icon_[a-z]+_3A"],
            "cssVariables": ["--sax-primary", "--sax-theme-bg", "--sax-border-color"]
          },
          {
            "defaults": {
              "confidence": "中"
            },
            "rules": [
              {
                "name": "Material UI",
                "patterns": ["@mui", "material-ui", "mui-", "data-emotion=\"css"],
                "classPrefixes": ["Mui"]
              },
              {
                "name": "Ant Design",
                "patterns": ["(?:^|/)antd(?:\\.min)?\\.(?:js|css)", "ant-design"],
                "classPrefixes": ["ant-"]
              },
              {
                "name": "Element UI / Element Plus",
                "patterns": [
                  "element-plus",
                  "element-ui",
                  "^(?=[\\s\\S]*(?:^|/)element/index(?:\\.min)?\\.js(?:[?#]|[\"'<>\\s]|$))(?=[\\s\\S]*(?:(?:^|/)element/index(?:\\.min)?\\.css(?:[?#]|[\"'<>\\s]|$)|el-(?:button|form|input|table|dialog|select)))"
                ],
                "classPrefixes": ["el-"]
              }
            ]
          },
          {
            "name": "Vuetify",
            "confidence": "高",
            "globals": ["Vuetify"],
            "selectors": [".v-application"]
          },
          {
            "defaults": {
              "confidence": "中"
            },
            "rules": [
              {
                "name": "Chakra UI",
                "patterns": ["@chakra-ui", "chakra-ui"],
                "classPrefixes": ["chakra-"],
                "selectors": ["[data-theme][style*=\"--chakra\"]"]
              },
              {
                "name": "Bulma",
                "patterns": ["bulma(?:\\.min)?\\.css"]
              },
              {
                "name": "Pico CSS",
                "patterns": ["@picocss/pico", "(?:^|/)pico(?:\\.classless)?(?:\\.min)?\\.css(?:[?#]|$)"]
              },
              {
                "name": "UnoCSS",
                "patterns": ["@unocss/", "(?:^|/)unocss(?:\\.min)?\\.css(?:[?#]|$)", "__unocss_hash"]
              },
              {
                "name": "Windi CSS",
                "patterns": ["@windicss/", "windicss", "(?:^|/)windi(?:\\.min)?\\.css(?:[?#]|$)"]
              },
              {
                "name": "Open Props",
                "patterns": ["@open-props/", "(?:^|/)open-props(?:\\.min)?\\.css(?:[?#]|$)"]
              },
              {
                "name": "Primer CSS",
                "patterns": ["@primer/css", "(?:^|/)primer(?:\\.min)?\\.css(?:[?#]|$)"]
              },
              {
                "name": "NES.css",
                "patterns": ["nes(?:\\.min)?\\.css(?:[?#]|$)", "nostalgic-css\\.github\\.io/NES\\.css"]
              },
              {
                "name": "Semantic UI / Fomantic UI",
                "patterns": ["semantic(?:\\.min)?\\.(?:css|js)", "fomantic"],
                "selectors": [".ui.button", ".ui.menu", ".ui.dropdown"]
              },
              {
                "name": "Foundation",
                "patterns": ["foundation(?:\\.min)?\\.(?:css|js)"],
                "classNames": ["grid-x", "top-bar", "callout"]
              }
            ]
          },
          {
            "name": "Ionic",
            "confidence": "高",
            "patterns": [
              "(?:^|/)ionic(?:\\.bundle)?(?:\\.min)?\\.(?:js|css)(?:[?#\"'<>\\s]|$)",
              "@ionic\\/(?:core|angular|react|vue)(?:[@/])",
              "(?:^|/)assets\\/ionic\\/"
            ],
            "selectors": ["ion-app", "ion-content", "ion-button"]
          },
          {
            "defaults": {
              "confidence": "中"
            },
            "rules": [
              {
                "name": "Quasar",
                "globals": ["Quasar"],
                "classPrefixes": ["q-"]
              },
              {
                "name": "Prime UI",
                "patterns": ["primevue", "primereact", "primeng"],
                "selectors": [".p-component", ".p-button", ".p-dialog"]
              },
              {
                "name": "Vant",
                "patterns": ["(?:^|[\\/@._-])vant(?:\\.min)?\\.(?:js|css)(?:[?#]|$)", "(?:^|[\\/@])vant(?:@|/es/|/lib/|/dist/)"],
                "classPrefixes": ["van-"]
              },
              {
                "name": "Arco Design",
                "patterns": ["arco-design"],
                "classPrefixes": ["arco-"]
              },
              {
                "name": "TDesign",
                "patterns": ["tdesign"],
                "classPrefixes": ["tdesign-"]
              },
              {
                "name": "Layui",
                "patterns": [
                  "(?:^|/)layui(?:\\.all)?(?:\\.min)?\\.(?:js|css)(?:[?#]|[\"'<>\\s]|$)",
                  "(?:^|/)layui/(?:layui|css/layui)[^\\s\"'<>]*\\.(?:js|css)(?:[?#]|[\"'<>\\s]|$)"
                ],
                "classNames": ["layui-btn", "layui-form"]
              }
            ]
          }
        ]
      },
      {
        "category": "构建与运行时",
        "name": "Emotion",
        "confidence": "中",
        "patterns": ["data-emotion="],
        "selectors": ["style[data-emotion]", "style[data-s]"]
      },
      {
        "category": "构建与运行时",
        "name": "styled-components",
        "confidence": "高",
        "patterns": ["<style[^>]*\\sdata-styled(?:-version)?="],
        "selectors": ["style[data-styled-version]", "style[data-styled]"],
        "versionFromAttribute": "data-styled-version"
      },
      {
        "category": "UI / CSS 框架",
        "name": "shadcn-vue",
        "url": "https://www.shadcn-vue.com",
        "confidence": "中",
        "matchIn": ["resources"],
        "minPatternMatches": 5,
        "patterns": [
          "(?:^|/)Card\\.vue_vue_type_script_setup",
          "(?:^|/)(?:Dialog|Sheet)(?:Title|Content|Description|Footer|ScrollContent)?\\.vue_vue_type_script_setup",
          "(?:^|/)Tabs(?:Trigger|Content|List)?\\.vue_vue_type_script_setup",
          "(?:^|/)DropdownMenu(?:Trigger|Content|Item|Separator|CheckboxItem|RadioItem)?\\.vue_vue_type_script_setup",
          "(?:^|/)Popover(?:Trigger|Content)?\\.vue_vue_type_script_setup",
          "(?:^|/)Tooltip(?:Trigger|Content|Provider)?\\.vue_vue_type_script_setup",
          "(?:^|/)Avatar(?:Image|Fallback)?\\.vue_vue_type_script_setup",
          "(?:^|/)Separator\\.vue_vue_type_script_setup",
          "(?:^|/)Input\\.vue_vue_type_script_setup",
          "(?:^|/)Label\\.vue_vue_type_script_setup",
          "(?:^|/)Checkbox\\.vue_vue_type_script_setup",
          "(?:^|/)Switch\\.vue_vue_type_script_setup",
          "(?:^|/)Skeleton\\.vue_vue_type_script_setup",
          "(?:^|/)Sidebar(?:Provider|Trigger|Content|Header|Footer)?\\.vue_vue_type_script_setup",
          "(?:^|/)Collapsible(?:Trigger|Content)?\\.vue_vue_type_script_setup",
          "(?:^|/)Combobox(?:Trigger|Content|Item|Input)?\\.vue_vue_type_script_setup",
          "(?:^|/)MultiSelect\\.vue_vue_type_script_setup",
          "(?:^|/)RadioGroup(?:Item)?\\.vue_vue_type_script_setup",
          "(?:^|/)Table(?:Head|Header|Body|Row|Cell|Pagination)?\\.vue_vue_type_script_setup",
          "(?:^|/)Textarea\\.vue_vue_type_script_setup"
        ]
      },
      {
        "defaults": {
          "category": "UI / CSS 框架",
          "confidence": "中"
        },
        "rules": [
          {
            "name": "Radix UI",
            "url": "https://www.radix-ui.com/",
            "patterns": ["@radix-ui\\/(?:react-|themes|colors)"]
          },
          {
            "name": "Headless UI",
            "url": "https://headlessui.com/",
            "patterns": ["@headlessui\\/(?:react|vue)(?:[@/])"],
            "selectors": ["[data-headlessui-state]"]
          },
          {
            "name": "Ark UI",
            "url": "https://ark-ui.com/",
            "patterns": ["@ark-ui\\/(?:react|vue|solid)(?:[@/])"],
            "selectors": ["[data-scope][data-part]"]
          },
          {
            "name": "Park UI",
            "url": "https://park-ui.com/",
            "patterns": ["@park-ui\\/(?:tailwind-plugin|panda-plugin)(?:[@/])"]
          },
          {
            "name": "Kobalte",
            "url": "https://kobalte.dev/",
            "patterns": ["@kobalte\\/(?:core|tailwindcss)(?:[@/])"]
          },
          {
            "name": "Reka UI",
            "url": "https://reka-ui.com/",
            "patterns": ["(?:^|[/@_-])reka-ui(?:[@/])"]
          },
          {
            "name": "Anu UI",
            "url": "https://anu-vue.netlify.app/",
            "patterns": ["(?:^|[/@_-])anu-vue(?:[@/])"],
            "classPrefixes": ["a-"]
          },
          {
            "name": "Oruga UI",
            "url": "https://oruga.io/",
            "patterns": ["@oruga-ui\\/oruga(?:-next)?(?:[@/])"],
            "classPrefixes": ["o-"]
          },
          {
            "name": "Vuesax",
            "url": "https://lusaxweb.github.io/vuesax/",
            "patterns": ["(?:^|[/@_-])vuesax(?:[@/])"],
            "classPrefixes": ["vs-"]
          },
          {
            "name": "AgnosticUI",
            "url": "https://www.agnosticui.com/",
            "patterns": ["(?:^|[/@_-])agnostic-(?:vue|react|svelte|angular)(?:[@/])"],
            "classPrefixes": ["agnostic-"]
          }
        ]
      },
      {
        "defaults": {
          "category": "UI / CSS 框架",
          "confidence": "高"
        },
        "rules": [
          {
            "name": "Shoelace / Web Awesome",
            "url": "https://shoelace.style/",
            "patterns": ["@shoelace-style\\/shoelace(?:[@/])"],
            "selectors": ["sl-button", "sl-input", "sl-dialog", "sl-dropdown"],
            "cssVariables": ["--sl-color-primary-600", "--sl-border-radius-medium", "--sl-font-sans"]
          },
          {
            "name": "Spectrum Web Components",
            "url": "https://opensource.adobe.com/spectrum-web-components/",
            "patterns": ["@spectrum-web-components\\/(?:button|dialog|overlay|theme)(?:[@/])"],
            "selectors": ["sp-button", "sp-dialog", "sp-overlay", "sp-theme"],
            "cssVariables": ["--spectrum-global-color-blue-400", "--spectrum-alias-border-color"]
          },
          {
            "name": "Fluent UI Web Components",
            "url": "https://fluent2.microsoft.design/",
            "patterns": ["@fluentui\\/web-components(?:[@/])"],
            "selectors": ["fluent-button", "fluent-text-field", "fluent-dialog", "fluent-select"],
            "cssVariables": ["--neutral-fill-rest", "--accent-fill-rest", "--neutral-foreground-rest"]
          }
        ]
      }
    ]
  }
}
